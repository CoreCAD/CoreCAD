<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1">
  <name>Built-In Preference Packs</name>
  <description>Preference Packs included with the CoreCAD distribution</description>
  <version>1.0.0</version>
  <maintainer email="email@corecad.org">CoreCAD</maintainer>
  <license file="../../LICENSE">LGPL2</license>
  <url type="repository">https://github.com/CoreCAD/CoreCAD</url>
  <content>
    <preferencepack>
      <name>CoreCAD Classic</name>
      <type>Theme</type>
      <description>Removes stylesheets, and applies the classic purple/gray background. Resets all colors to default</description>
      <version>1.0.0</version>
      <tag>built-in</tag>
      <tag>background</tag>
      <tag>no stylesheet</tag>
      <tag>classic theme</tag>
    </preferencepack>
	<preferencepack>
	  <name>CoreCAD Light</name>
      <type>Theme</type>
      <description>Applies a basic light theme.</description>
      <version>1.0.0</version>
      <tag>built-in</tag>
      <tag>background</tag>
      <tag>light</tag>
    </preferencepack>
	<preferencepack>
	  <name>CoreCAD Dark</name>
      <type>Theme</type>
      <description>Applies a basic dark theme.</description>
      <version>1.0.0</version>
      <tag>built-in</tag>
      <tag>background</tag>
      <tag>dark</tag>
    </preferencepack>
  </content>
</package>
